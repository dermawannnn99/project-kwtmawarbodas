APP_ENV=production

DB_HOST=localhost
DB_NAME=lezatpack_db
DB_USER=your_db_user
DB_PASS=your_db_password

# Kredensial admin default — dibuat otomatis saat tabel login kosong.
# Di production WAJIB isi password kuat (min 12 karakter). Kalau kosong/lemah,
# aplikasi generate password acak dan mencatatnya di logs/admin_credentials.txt.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GantiDenganPasswordKuatPanjang!

# Atur ke "true" di production (HTTPS). Di local dev HTTP, set ke "false".
SESSION_SECURE=true
